[Unit]
Description=Run native Zepp synchronization at fixed local freshness times

[Timer]
OnCalendar=*-*-* 02:00:00 Europe/Ljubljana
OnCalendar=*-*-* 06:30:00 Europe/Ljubljana
OnCalendar=*-*-* 08:30:00 Europe/Ljubljana
OnCalendar=*-*-* 12:00:00 Europe/Ljubljana
OnCalendar=*-*-* 18:00:00 Europe/Ljubljana
OnCalendar=*-*-* 22:00:00 Europe/Ljubljana
Persistent=true
Unit=zepp-health-sync.service

[Install]
WantedBy=timers.target
